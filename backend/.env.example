# FreeGraduates AI Resume Builder - Environment Configuration
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` to version control.

# ---------- Server ----------
# Port for the Python backend
PORT=8000
# Allowed frontend origins (CORS). Comma-separated.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to "true" only for local development (skips Firebase token verification)
DEV_AUTH_BYPASS=false

# ---------- AI Provider (Google Gemini) ----------
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model used for generation / extraction
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# ---------- Firebase Admin (server-side auth) ----------
# Path to the Firebase service account JSON file. Required to verify
# ID tokens issued by the Firebase client SDK on the frontend.
# See: https://firebase.google.com/docs/admin/setup
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Optional: print a friendly warning when Firebase is not configured
FIREBASE_PROJECT_ID=freegraduates

# ---------- Storage ----------
# Where user-specific resumes and CV uploads live (relative to backend/)
DATA_DIR=./app/data
# Maximum upload size (bytes) — default 16 MB
MAX_UPLOAD_BYTES=16777216

# ---------- Poppler (required for pdf2image on Windows) ----------
# Absolute path to poppler's bin folder (where pdftoppm.exe lives).
# Leave blank on Linux/macOS (system PATH is used).
POPPLER_PATH=