# FreeGraduates Frontend - Environment Configuration
# Copy this file to `.env` for local development. Vercel must set these
# variables in its Project Settings > Environment Variables for production.

# Backend API base URL (Python FastAPI server deployed on Render).
# Local dev:
VITE_API_URL=http://localhost:8000
# Production MUST point at the Render backend, e.g.:
# VITE_API_URL=https://freegraduates-backend.onrender.com

# Firebase Client SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=freegraduates
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id